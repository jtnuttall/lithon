{
  "name": "lithon-core",
  "description": "The lithon engine surface: Vulkan 1.3 baseline with optional 1.4, modern WSI, debugging/perf tooling, ray tracing, mesh shading, and the still-relevant dynamic-pipeline family. Turing/RDNA2-class hardware and newer.",
  "registry": { "headerVersion": 356 },
  "core": { "baseline": "1.3", "max": "1.4" },
  "platforms": [
    "wayland",
    "xcb",
    "xlib",
    "xlib_xrandr",
    "win32",
    "metal",
    "macos",
    "provisional"
  ],
  "extensions": [
    { "name": "VK_KHR_surface", "rationale": "WSI root" },
    { "name": "VK_KHR_swapchain", "rationale": "presentation" },
    "VK_KHR_get_surface_capabilities2",
    "VK_KHR_wayland_surface",
    "VK_KHR_xcb_surface",
    "VK_KHR_xlib_surface",
    "VK_KHR_win32_surface",
    "VK_EXT_metal_surface",
    "VK_EXT_headless_surface",
    { "name": "VK_KHR_display", "rationale": "kiosk/CI direct-to-display" },
    "VK_KHR_get_display_properties2",
    "VK_EXT_direct_mode_display",
    "VK_EXT_acquire_xlib_display",
    { "name": "VK_KHR_portability_enumeration", "rationale": "MoltenVK discovery" },
    { "name": "VK_KHR_portability_subset", "rationale": "MoltenVK device compat" },
    "VK_EXT_surface_maintenance1",
    "VK_EXT_swapchain_maintenance1",
    { "name": "VK_KHR_present_id", "rationale": "frame pacing" },
    "VK_KHR_present_wait",
    "VK_EXT_swapchain_colorspace",
    { "name": "VK_EXT_hdr_metadata", "rationale": "HDR output" },
    { "name": "VK_EXT_full_screen_exclusive", "rationale": "win32 fullscreen" },

    { "name": "VK_EXT_debug_utils", "rationale": "names, labels, validation callbacks" },
    { "name": "VK_EXT_layer_settings", "rationale": "modern validation config" },
    "VK_EXT_device_fault",
    "VK_EXT_device_address_binding_report",
    "VK_EXT_memory_budget",
    "VK_EXT_memory_priority",
    "VK_EXT_pageable_device_local_memory",
    "VK_KHR_calibrated_timestamps",
    "VK_KHR_pipeline_executable_properties",
    { "name": "VK_KHR_performance_query", "rationale": "profiling" },

    { "name": "VK_KHR_deferred_host_operations", "rationale": "RT prerequisite" },
    { "name": "VK_KHR_acceleration_structure", "rationale": "ray tracing" },
    "VK_KHR_ray_tracing_pipeline",
    "VK_KHR_ray_query",
    "VK_KHR_ray_tracing_maintenance1",
    "VK_KHR_ray_tracing_position_fetch",
    { "name": "VK_EXT_opacity_micromap", "rationale": "RT alpha-tested geometry" },

    { "name": "VK_EXT_mesh_shader", "rationale": "primary geometry path" },
    "VK_KHR_fragment_shading_rate",
    "VK_KHR_fragment_shader_barycentric",
    "VK_EXT_conservative_rasterization",
    "VK_EXT_sample_locations",
    "VK_KHR_shader_clock",
    "VK_EXT_shader_image_atomic_int64",
    "VK_KHR_workgroup_memory_explicit_layout",
    "VK_KHR_shader_maximal_reconvergence",
    "VK_KHR_shader_quad_control",
    "VK_KHR_compute_shader_derivatives",
    "VK_KHR_shader_subgroup_uniform_control_flow",

    { "name": "VK_EXT_graphics_pipeline_library", "rationale": "hitch-free pipeline compilation" },
    "VK_KHR_pipeline_library",
    { "name": "VK_EXT_shader_object", "rationale": "pipeline-less iteration path" },
    { "name": "VK_EXT_descriptor_buffer", "rationale": "modern descriptor model" },
    "VK_EXT_extended_dynamic_state3",
    "VK_EXT_vertex_input_dynamic_state",
    "VK_EXT_color_write_enable",
    "VK_EXT_multi_draw",
    "VK_EXT_dynamic_rendering_unused_attachments",
    "VK_KHR_maintenance7",
    "VK_KHR_maintenance8",
    "VK_KHR_unified_image_layouts",
    "VK_KHR_pipeline_binary",
    "VK_EXT_robustness2",

    "VK_KHR_external_memory_fd",
    "VK_KHR_external_semaphore_fd",
    "VK_KHR_external_fence_fd",
    { "name": "VK_EXT_external_memory_dma_buf", "rationale": "Linux zero-copy interop" },
    "VK_EXT_image_drm_format_modifier",
    "VK_EXT_external_memory_host",
    "VK_KHR_external_memory_win32",
    "VK_KHR_external_semaphore_win32",
    "VK_KHR_external_fence_win32"
  ],
  "exclude": [],
  "policy": {
    "dependencies": "auto",
    "includePromotedToOptionalCores": true,
    "allowProvisional": ["VK_KHR_portability_subset"],
    "denySpecialUse": ["d3demulation", "glemulation", "cadsupport"],
    "allowDeprecated": true,
    "legacyCore": {
      "mode": "exclude",
      "categories": [
        "deprecation-sync2",
        "legacy-renderpass2",
        "legacy-dynamicrendering",
        "legacy-flagbits",
        "legacy-gpdp2",
        "legacy-gpdsc2",
        "legacy-devicelayers",
        "legacy-version-macros",
        "legacy-host-builds"
      ]
    },
    "warnOnRegistryDrift": true
  }
}
