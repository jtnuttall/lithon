{-| Enumerate the toys, invoking the callback for each one.

    === __@sdl3-bindgen-sys@ notes__

    [FFI safety]: __Safe__ foreign import of @SDL_ToyEnumerate@.
                  The unsafe import is not exported
                  : invokes the callback synchronously.
                  If your callback is a non-Haskell function pointer that never
re-enters the Haskell runtime, the unsafe import remains available as @SDL3.Sys.Bindgen.Toy.Unsafe.sDL_ToyEnumerate@.

    [C declaration]: @SDL_ToyEnumerate@, defined at @SDL_toy.h 105:6@
-}
toyEnumerateSafe ::
     SDL_ToyCallback
     {- ^

          [@callback@]: the per-toy callback.

     -}
  -> BG.Ptr BG.Void
     {- ^

          [@userdata@]: app pointer.

     -}
  -> IO ()
toyEnumerateSafe = Safe.sDL_ToyEnumerate

