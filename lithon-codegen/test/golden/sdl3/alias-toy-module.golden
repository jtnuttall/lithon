{-| Typed constant for macro @SDL_TOY_A@. Combine with @.|.@ from "Data.Bits".
-}
pattern SDL_TOY_A :: SDL_ToyFlags
pattern SDL_TOY_A = SDL_ToyFlags 0x00000001

{-| Typed constant for macro @SDL_TOY_B@. Combine with @.|.@ from "Data.Bits".
-}
