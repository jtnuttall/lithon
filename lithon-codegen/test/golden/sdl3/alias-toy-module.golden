    , SDL3.Sys.Toy.toyEnumerateSafe
    , SDL3.Sys.Toy.setToyCallback
    , SDL3.Sys.Toy.setToyCallbackSafe
    , SDL3.Sys.Toy.getToyCallback
    , SDL3.Sys.Toy.getToyCallbackSafe
    )
  where

import qualified Data.Coerce as Coerce
import qualified HsBindgen.Runtime.CBool as CBool
