import qualified SDL3.Sys.Bindgen.Toy.Safe as Safe
import qualified SDL3.Sys.Bindgen.Toy.Unsafe as Unsafe
import SDL3.Sys.Bindgen.Toy

{-| Create a toy thing.

    The thing writes into read\/write locks in the \/unlocked\/ state. Pass @'sDL_TOY_A'@ to enable the A capability.

    @
    SDL_ToyThing *t = SDL_CreateToyThing(4);
    printf(\"%d\\n\", t->size);
    @

    [Returns]: a new thing.

    [Thread safety]: It is safe to call this function from any thread.

    @since 3.2.0

    [See also]: 'toyEnumerateSafe', 'toyIsOk'

    === __@sdl3-bindgen-sys@ notes__

    [FFI safety]: __Unsafe__ foreign import of @SDL_CreateToyThing@.
                  The safe import is not exported
                  : toy pin of the opt-out class.

    [Scalars]: The binding generation has mapped C scalars to native Haskell scalars for this function.
               Pointers and structs are untouched by this best-effort mapping. Higher-level bindings are expected to map structs and pointers as appropriate.

    [C declaration]: @SDL_CreateToyThing@, defined at @SDL_toy.h 60:15@
-}
createToyThing ::
     BG.Int32
     {- ^

          [@size@]: how big.

     -}
  -> IO (BG.Ptr SDL_ToyThing)
createToyThing =
  \x00 -> Unsafe.sDL_CreateToyThing (Coerce.coerce x00)

{-| Check a toy against a pair of thresholds.

    [Returns]: true if the toy is ok.

    === __@sdl3-bindgen-sys@ notes__

    [FFI safety]: __Unsafe__ foreign import of @SDL_ToyIsOk@.
                  The safe flavor is 'toyIsOkSafe'
                  .

    [Scalars]: The binding generation has mapped C scalars to native Haskell scalars for this function.
               Pointers and structs are untouched by this best-effort mapping. Higher-level bindings are expected to map structs and pointers as appropriate.

    [C declaration]: @SDL_ToyIsOk@, defined at @SDL_toy.h 69:6@
-}
toyIsOk ::
     Float
     {- ^

          [@x@]: low water mark.

     -}
  -> Double
     {- ^

          [@y@]: high water mark.

     -}
  -> IO Bool
toyIsOk =
  \x00 ->
    \x11 ->
      fmap CBool.toBool (Unsafe.sDL_ToyIsOk (Coerce.coerce x00) (Coerce.coerce x11))

