    pokeChain (castPtr (p `plusPtr` 8)) x.next
    liftIO (pokeByteOff p 16 x.flags)
    p_applicationInfo <- maybe (pure nullPtr) new x.applicationInfo
    liftIO (pokeByteOff p 24 p_applicationInfo)
    p_enabledLayerNames <- newCStrings x.enabledLayerNames
    liftIO (pokeByteOff p 40 (if V.null x.enabledLayerNames then nullPtr else p_enabledLayerNames))
    liftIO (pokeByteOff p 32 (fromIntegral (V.length x.enabledLayerNames) :: Word32))
    p_enabledExtensionNames <- newCStrings x.enabledExtensionNames
    liftIO (pokeByteOff p 56 (if V.null x.enabledExtensionNames then nullPtr else p_enabledExtensionNames))
    liftIO (pokeByteOff p 48 (fromIntegral (V.length x.enabledExtensionNames) :: Word32))
    pure ()

instance (AllExtends InstanceCreateInfo es, PokeChain es, PeekChain es) => FromCStruct (InstanceCreateInfo es) where
  peekCStruct p = do
    v_next <- peekChain =<< peekByteOff p 8
    v_flags <- (peekByteOff p 16)
    v_applicationInfo <- do { q <- peekByteOff p 24; if q == nullPtr then pure Nothing else Just <$> peekCStruct q }
    v_enabledLayerNames <- do { n <- (peekByteOff p 32 :: IO Word32); q <- peekByteOff p 40; V.generateM (fromIntegral n) (\i -> BS.packCString =<< peekElemOff q i) }
    v_enabledExtensionNames <- do { n <- (peekByteOff p 48 :: IO Word32); q <- peekByteOff p 56; V.generateM (fromIntegral n) (\i -> BS.packCString =<< peekElemOff q i) }
    pure InstanceCreateInfo{next = v_next, flags = v_flags, applicationInfo = v_applicationInfo, enabledLayerNames = v_enabledLayerNames, enabledExtensionNames = v_enabledExtensionNames}

instance (NilChain es) => Nil (InstanceCreateInfo es) where
  nil =
    InstanceCreateInfo
      { next = nilChain
      , flags = mempty
      , applicationInfo = Nothing
      , enabledLayerNames = V.empty
      , enabledExtensionNames = V.empty
      }


