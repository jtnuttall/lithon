-- | Registry: <https://registry.khronos.org/vulkan/specs/latest/man/html/vkEnumeratePhysicalDevices.html vkEnumeratePhysicalDevices>
-- Available: VK_VERSION_1_0
enumeratePhysicalDevices ::
  forall m.
  (MonadIO m) =>
  Instance ->
  m (Outcome (V.Vector PhysicalDevice))
enumeratePhysicalDevices instance' =
  liftIO $ withArena \arena_ -> runAlloc arena_ do
    p_n_ <- arenaBytes 4 4
    liftIO (pokeByteOff p_n_ 0 (0 :: Word32))
    let goDual_ = do
          r1_ <- liftIO (mkEnumeratePhysicalDevices (checkCommandPtr "vkEnumeratePhysicalDevices" instance'.cmds.pEnumeratePhysicalDevices) (castPtr instance'.handle) (castPtr p_n_) nullPtr)
          if r1_ < 0
            then pure (Err (openFromWire r1_))
            else do
              n_pPhysicalDeviceCount <- liftIO (peekByteOff p_n_ 0 :: IO Word32)
              p_o_physicalDevices <- arenaBytes (8 * max 1 (fromIntegral n_pPhysicalDeviceCount)) 8
              r2_ <- liftIO (mkEnumeratePhysicalDevices (checkCommandPtr "vkEnumeratePhysicalDevices" instance'.cmds.pEnumeratePhysicalDevices) (castPtr instance'.handle) (castPtr p_n_) (castPtr p_o_physicalDevices))
              n_pPhysicalDeviceCount' <- liftIO (peekByteOff p_n_ 0 :: IO Word32)
              if r2_ == 5
                then goDual_
                else
                  if r2_ < 0
                    then pure (Err (openFromWire r2_))
                    else do
                      o_physicalDevices <- liftIO (V.generateM (fromIntegral n_pPhysicalDeviceCount') (\i -> (\hp -> PhysicalDevice (castPtr hp) instance'.cmds) <$> peekElemOff (castPtr p_o_physicalDevices :: Ptr (Ptr ())) i))
                      pure (Ok (openFromWire r2_) o_physicalDevices)
    goDual_

