-- | Registry: <https://registry.khronos.org/vulkan/specs/latest/man/html/vkCreateInstance.html vkCreateInstance>
-- Available: VK_VERSION_1_0
createInstance ::
  forall m es0.
  (MonadIO m, AllExtends InstanceCreateInfo es0, PokeChain es0) =>
  InstanceCreateInfo es0 ->
  Maybe AllocationCallbacks ->
  m (Outcome Instance)
createInstance createInfo allocator =
  liftIO $ withArena \arena_ -> runAlloc arena_ do
    p_createInfo :: Ptr () <- castPtr <$> new createInfo
    p_allocator :: Ptr () <- maybe (pure nullPtr) (fmap castPtr . new) allocator
    p_o_instance' <- arenaBytes 8 8
    r_ <- liftIO (mkCreateInstance (checkCommandPtr "vkCreateInstance" globalCmds.pCreateInstance) p_createInfo p_allocator (castPtr p_o_instance'))
    if r_ < 0
      then pure (Err (openFromWire r_))
      else do
        hp_o_instance' <- liftIO (peekByteOff p_o_instance' 0 :: IO (Ptr ()))
        o_instance' <- liftIO (Instance (castPtr hp_o_instance') <$> initInstanceCmds hp_o_instance')
        pure (Ok (openFromWire r_) o_instance')

withInstance ::
  forall m r es0.
  (MonadUnliftIO m, AllExtends InstanceCreateInfo es0, PokeChain es0) =>
  InstanceCreateInfo es0 ->
  Maybe AllocationCallbacks ->
  (Outcome Instance -> m r) ->
  m r
withInstance createInfo allocator cont_ =
  withRunInIO \run_ ->
    bracket
      (run_ (createInstance createInfo allocator))
      (\o_ -> case o_ of
          Ok _ h_ -> run_ (destroyInstance h_ allocator)
          Err _ -> pure ())
      (run_ . cont_)


